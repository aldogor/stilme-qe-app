# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Environment files with secrets
.env
.env.*

# Android Studio
.idea/
*.iml
.DS_Store

# Keystore files
*.jks
*.keystore

# Update distribution (contains Google Drive URLs)
update-info.json

# docs/ is tracked in the internal repository and left out of the public cut (public_exclude.txt).
# These parts of it stay out of every repository:
# - study data: pseudonymised health data stays on this machine and on MedCap, never on GitHub
docs/data/raw/
docs/data/processed/
# - mirror of the team's Google Drive folder: Drive is its source and keeps its own history
docs/drive/
# - literature build caches, logs and scratch files, regenerated by the scripts
docs/literature/work/cache_*.json
docs/literature/work/*.log
docs/literature/work/_*
docs/literature/work/rejected/

# Claude Code local config and third-party skills stay local; project skills (stilme-*) travel with the repo
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/stilme-*/

# Python bytecode (literature and tool scripts)
__pycache__/
*.pyc
