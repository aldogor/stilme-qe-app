# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Environment files with secrets
.env
.env.*

# Android Studio
.idea/
*.iml
.DS_Store

# Keystore files
*.jks
*.keystore

# Update distribution (contains Google Drive URLs)
update-info.json

# docs/ is tracked in the internal repository only: publish.txt does not name it.
# These parts of it stay out of every repository:
# - study data: pseudonymised health data stays on this machine and on MedCap, never on GitHub.
#   The online project's data dictionary and the codebook of the processed tables describe fields,
#   not participants, and are tracked
docs/data/raw/*
!docs/data/raw/medcap_online_*/
docs/data/raw/medcap_online_*/*
!docs/data/raw/medcap_online_*/*_DataDictionary_*.csv
docs/data/processed/*
!docs/data/processed/codebook.csv
# - mirror of the team's Google Drive folder: Drive is its source and keeps its own history
docs/drive/
# - the texts of the literature library: publishers' PDFs and their Markdown cannot be passed on;
#   bibliography.csv, the master record, is tracked
docs/literature/*
!docs/literature/bibliography.csv
# - the R package library of the analysis scripts is ignored by docs/scripts/renv/.gitignore

# Claude Code: .claude/settings.json is the repository's whole Claude configuration and travels with it, as do
# the project skills (stilme-*); settings.local.json, CLAUDE.local.md and third-party skills stay local
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/stilme-*/
CLAUDE.local.md

# Python bytecode (tools/ scripts)
__pycache__/
*.pyc
