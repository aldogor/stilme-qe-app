#!/bin/sh
# Pre-push guard for the internal/public split (install: cp tools/pre-push .git/hooks/pre-push).
#
# The remote "public" may receive only the public cut built by tools/publish_public.py on the
# local branch public-master; pushing master (the internal history, with docs/ and JOURNAL.md)
# there would publish private material. Any other push to "public" is refused.

remote="$1"
[ "$remote" = "public" ] || exit 0

while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_ref" != "refs/heads/public-master" ]; then
        echo "pre-push: refused to push $local_ref to the public remote." >&2
        echo "Build the cut with 'python tools/publish_public.py' and push 'public-master:master'." >&2
        exit 1
    fi
done
exit 0
